# Copy this file to .env.local for local development. Never commit real secrets.
# In Vercel, add the same values under Project Settings > Environment Variables.
NEXT_PUBLIC_SITE_URL=https://sandbee.in

# Server-only: your existing contact API. Keep empty until the real endpoint exists.
# Receives JSON { name, email, message, submittedAt }; a 2xx response acknowledges delivery.
CONTACT_TRANSPORT_URL=
# Optional bearer token, only if your API requires bearer authentication.
CONTACT_TRANSPORT_TOKEN=
