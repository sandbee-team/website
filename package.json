{
  "name": "sandbee-website",
  "version": "0.1.0",
  "private": true,
  "description": "Public website for sandbee.in",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:rules": "node scripts/check-design-rules.mjs",
    "e2e": "playwright test tests/e2e",
    "a11y": "playwright test tests/a11y",
    "analyze": "next experimental-analyze --output",
    "check:portable": "node scripts/check-portability.mjs",
    "check": "npm run lint && npm run check:rules && npm run check:portable && npm test && npm run build",
    "package:handoff": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-handoff.ps1"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.6",
    "d3-force": "^3.0.0",
    "gray-matter": "^4.0.3",
    "motion": "^13.1.1",
    "next": "16.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "schema-dts": "^2.0.0",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
